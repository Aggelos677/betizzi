{
  // betizzi – η σελίδα. Σελίδες SSR από src/index.js, στατικά αρχεία από public/.
  "name": "betizzi-web",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  // Δεδομένα από το betizzi-engine (αργότερα modix-bt-v2, αλλάζει μόνο το src/data.js)
  "services": [{ "binding": "ENGINE", "service": "betizzi-engine" }],
  // 06/11: έτοιμες σελίδες (σήμερα + αύριο, 9 γλώσσες), παγκόσμια, για να μην περιμένει ποτέ ο επισκέπτης. Γεμίζει από το cron.
  "kv_namespaces": [{ "binding": "PAGESKV", "id": "2cf2509b7d884cdf9d08813f31805735" }],
  "triggers": { "crons": ["*/10 * * * *"] },
  // Δικό μας domain (ζώνη betizzi.com στο Cloudflare). www → 301 στο betizzi.com (src/index.js).
  "routes": [
    { "pattern": "betizzi.com", "custom_domain": true },
    { "pattern": "www.betizzi.com", "custom_domain": true }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": { "enabled": true },
  // Δοκιμαστικό link (Worker Previews): κάθε branch εκτός main → <branch>-betizzi-web...workers.dev
  // Διαβάζει τα ίδια δεδομένα από το betizzi-engine (μόνο ανάγνωση).
  "previews": {
    "services": [{ "binding": "ENGINE", "service": "betizzi-engine" }],
    "kv_namespaces": [{ "binding": "PAGESKV", "id": "2cf2509b7d884cdf9d08813f31805735" }]
  }
}
